{
  "name": "playwright-bookstore-login-exercise",
  "version": "1.0.0",
  "private": true,
  "description": "Ejercicio de login y catálogo de libros con Playwright y TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:login": "playwright test tests/login.spec.ts",
    "test:books": "playwright test tests/books.spec.ts",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.0"
  }
}
